# local postgres only. hackathon rule: no hosted db.
# create role + db first:
#   psql -U postgres -c "CREATE ROLE dayflow LOGIN PASSWORD 'dayflow';" -c "CREATE DATABASE dayflow OWNER dayflow;"
DATABASE_URL="postgresql://dayflow:dayflow@localhost:5432/dayflow?schema=public"

# session signing key. regen per env: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-64-char-random-hex"
